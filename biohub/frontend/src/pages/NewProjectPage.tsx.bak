import { useState, useCallback } from 'react'
import { useNavigate } from 'react-router-dom'
import { useDropzone } from 'react-dropzone'
import { trpc } from '../lib/trpc'
import { Sidebar } from '../components/Sidebar'
import { Header } from '../components/Header'

export const NewProjectPage = () => {
  const navigate = useNavigate()
  const [name, setName] = useState('')
  const [type, setType] = useState('alignment')
  const [description, setDescription] = useState('')
  const [sampleId, setSampleId] = useState('')
  const [status, setStatus] = useState('active')
  const [platform, setPlatform] = useState('')
  const [qcStatus, setQcStatus] = useState('pending')
  const [experimentDate, setExperimentDate] = useState('')
  const [activeStages, setActiveStages] = useState({ stage1: false, stage2: false, stage3: false, stage4: false })
  const [files, setFiles] = useState({
    fastq_r1: [] as File[],
    fastq_r2: [] as File[],
    bam: [] as File[],
    vcf: [] as File[],
    annotation: [] as File[]
  })
  const [uploading, setUploading] = useState(false)
  const createProject = trpc.project.create.useMutation()
  const getUploadUrl = trpc.file.getUploadUrl.useMutation()

  const toggleStage = (stage: string) => {
    setActiveStages(prev => ({ ...prev, [stage]: !prev[stage] }))
  }

  const onDrop = useCallback((acceptedFiles: File[], stage: string) => {
    setFiles(prev => ({ ...prev, [stage]: [...prev[stage], ...acceptedFiles] }))
  }, [])

  const allFiles = Object.values(files).flat()
  const totalFilesCount = allFiles.length
  const totalFilesSize = allFiles.reduce((sum, f) => sum + f.size, 0)
  const totalSizeGB = (totalFilesSize / 1e9).toFixed(2)

  const uploadFileToServer = async (file: File, stage: string, projectId: string) => {
    const { uploadUrl, fileId } = await getUploadUrl.mutateAsync({
      projectId, stage, fileName: file.name, fileSize: file.size, mimeType: file.type
    })
    await fetch(uploadUrl, { method: 'PUT', body: file, headers: { 'Content-Type': file.type } })
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!name) { alert('Укажите название анализа'); return }
    setUploading(true)
    try {
      const project = await createProject.mutateAsync({
        name, type, description, sampleId,
        status,
        platform: platform || null,
        qcStatus,
        experimentDate: experimentDate || null,
        pipelineParams: {}, computeEnv: { cluster: 'aws-batch', cpu: 16, memory: 64, priority: 'Средний' },
        advanced: {}
      })
      for (const [stage, fileList] of Object.entries(files)) {
        for (const file of fileList) {
          await uploadFileToServer(file, stage, project.id)
        }
      }
      alert('Проект создан и файлы загружены')
      navigate(`/projects/${project.id}`)
    } catch (err) {
      console.error(err)
      alert('Ошибка при создании проекта')
    } finally {
      setUploading(false)
    }
  }

  return (
    <div className="flex h-screen">
      <Sidebar />
      <main className="flex-1 flex flex-col overflow-hidden">
        <Header />
        <div className="flex-1 overflow-y-auto p-8 max-w-6xl mx-auto w-full">
          <h1 className="text-2xl font-semibold text-white mb-6">Создание нового анализа</h1>
          <form onSubmit={handleSubmit} className="space-y-8">
            <div className="bg-surface border border-borderLine rounded-custom p-6">
              <h2 className="text-lg font-medium border-b border-borderLine pb-2 mb-4"><i className="ph ph-info text-accent"></i> Базовые параметры</h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div><label className="block text-muted text-sm mb-1">Название анализа *</label><input type="text" value={name} onChange={e => setName(e.target.value)} className="w-full" required /></div>
                <div><label className="block text-muted text-sm mb-1">Тип анализа *</label><select value={type} onChange={e => setType(e.target.value)} className="w-full"><option value="alignment">Выравнивание (FASTQ → BAM)</option><option value="variant">Вызов вариантов (BAM → VCF)</option><option value="rna">RNA-seq</option><option value="cnv">CNV</option><option value="multiomics">Multi‑omics</option></select></div>
                <div className="md:col-span-2"><label className="block text-muted text-sm mb-1">Описание</label><textarea rows={2} value={description} onChange={e => setDescription(e.target.value)} className="w-full" /></div>
                <div><label className="block text-muted text-sm mb-1">Статус проекта</label><select value={status} onChange={e => setStatus(e.target.value)} className="w-full"><option value="active">Активен</option><option value="in_progress">В работе</option><option value="completed">Завершён</option></select></div>
                <div><label className="block text-muted text-sm mb-1">Платформа</label><select value={platform} onChange={e => setPlatform(e.target.value)} className="w-full"><option value="">Не выбрано</option><option value="Illumina">Illumina</option><option value="MinION">MinION</option><option value="PacBio">PacBio</option><option value="Oxford Nanopore">Oxford Nanopore</option></select></div>
                <div><label className="block text-muted text-sm mb-1">Статус QC</label><select value={qcStatus} onChange={e => setQcStatus(e.target.value)} className="w-full"><option value="pending">Ожидание</option><option value="passed">Пройден</option><option value="failed">Не пройден</option></select></div>
                <div><label className="block text-muted text-sm mb-1">Дата эксперимента</label><input type="date" value={experimentDate} onChange={e => setExperimentDate(e.target.value)} className="w-full" /></div>
              </div>
            </div>

            <div className="bg-surface border border-borderLine rounded-custom p-6">
              <h2 className="text-lg font-medium border-b border-borderLine pb-2 mb-4"><i className="ph ph-upload-simple text-accent"></i> Загрузка файлов по стадиям</h2>
              <p className="text-xs text-muted -mt-2 mb-4">Поддерживаются .fastq.gz, .bam, .cram, .vcf.gz, .bed, .gtf. Макс. 100 ГБ.</p>

              <div className="border border-borderLine rounded-custom overflow-hidden mb-3">
                <button type="button" onClick={() => toggleStage('stage1')} className="w-full text-left px-4 py-3 bg-white/[0.02] hover:bg-surfaceHover flex justify-between"><span><i className="ph ph-dna text-accent mr-2"></i> 1. Сырые чтения (FASTQ)</span><i className={`ph ph-caret-down transition ${activeStages.stage1 ? 'rotate-180' : ''}`}></i></button>
                {activeStages.stage1 && <div className="p-4 border-t border-borderLine">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <FileDropZone stage="fastq_r1" label="R1 (Forward)" files={files.fastq_r1} setFiles={setFiles} />
                    <FileDropZone stage="fastq_r2" label="R2 (Reverse)" files={files.fastq_r2} setFiles={setFiles} />
                  </div>
                  <div className="mt-2"><label className="text-xs text-muted">ID образца</label><input type="text" value={sampleId} onChange={e => setSampleId(e.target.value)} className="w-full bg-base border border-borderLine rounded px-2 py-1 text-sm mt-1" /></div>
                </div>}
              </div>

              <div className="border border-borderLine rounded-custom overflow-hidden mb-3">
                <button type="button" onClick={() => toggleStage('stage2')} className="w-full text-left px-4 py-3 bg-white/[0.02] hover:bg-surfaceHover flex justify-between"><span><i className="ph ph-align-center-simple text-accent mr-2"></i> 2. Выравнивание (BAM/CRAM)</span><i className={`ph ph-caret-down transition ${activeStages.stage2 ? 'rotate-180' : ''}`}></i></button>
                {activeStages.stage2 && <div className="p-4 border-t border-borderLine"><FileDropZone stage="bam" label="BAM/CRAM" files={files.bam} setFiles={setFiles} /></div>}
              </div>

              <div className="border border-borderLine rounded-custom overflow-hidden mb-3">
                <button type="button" onClick={() => toggleStage('stage3')} className="w-full text-left px-4 py-3 bg-white/[0.02] hover:bg-surfaceHover flex justify-between"><span><i className="ph ph-file-code text-accent mr-2"></i> 3. Варианты (VCF/gVCF)</span><i className={`ph ph-caret-down transition ${activeStages.stage3 ? 'rotate-180' : ''}`}></i></button>
                {activeStages.stage3 && <div className="p-4 border-t border-borderLine"><FileDropZone stage="vcf" label="VCF/gVCF" files={files.vcf} setFiles={setFiles} /></div>}
              </div>

              <div className="border border-borderLine rounded-custom overflow-hidden mb-3">
                <button type="button" onClick={() => toggleStage('stage4')} className="w-full text-left px-4 py-3 bg-white/[0.02] hover:bg-surfaceHover flex justify-between"><span><i className="ph ph-map-pin text-accent mr-2"></i> 4. Аннотации (BED/GTF/GFF)</span><i className={`ph ph-caret-down transition ${activeStages.stage4 ? 'rotate-180' : ''}`}></i></button>
                {activeStages.stage4 && <div className="p-4 border-t border-borderLine"><FileDropZone stage="annotation" label="BED/GTF/GFF" files={files.annotation} setFiles={setFiles} /></div>}
              </div>

              <div className="mt-4 p-3 bg-surfaceHover rounded border border-borderLine">
                <div className="flex justify-between text-sm"><span className="text-muted">Всего файлов:</span><span className="text-white font-semibold">{totalFilesCount}</span></div>
                <div className="flex justify-between text-sm mt-1"><span className="text-muted">Общий размер:</span><span className="text-white font-semibold">{totalSizeGB} ГБ</span></div>
              </div>
            </div>
            <div className="flex justify-end gap-4">
              <button type="button" onClick={() => navigate('/')} className="px-5 py-2 border border-borderLine rounded-custom text-muted">Отмена</button>
              <button type="submit" disabled={uploading} className="px-6 py-2 bg-accent rounded-custom font-semibold disabled:opacity-50">{uploading ? 'Загрузка...' : 'Сохранить проект'}</button>
            </div>
          </form>
        </div>
      </main>
    </div>
  )
}

const FileDropZone = ({ stage, label, files, setFiles }: { stage: string; label: string; files: File[]; setFiles: any }) => {
  const onDrop = useCallback((accepted: File[]) => {
    setFiles((prev: any) => ({ ...prev, [stage]: [...prev[stage], ...accepted] }))
  }, [stage, setFiles])
  const { getRootProps, getInputProps } = useDropzone({ onDrop })
  return (
    <div {...getRootProps()} className="dropzone-stage border-2 border-dashed border-borderLine rounded-custom p-3 text-center cursor-pointer hover:border-accent">
      <input {...getInputProps()} />
      <i className="ph ph-cloud-arrow-up text-xl text-muted"></i>
      <p className="text-xs">{label}</p>
      {files.length > 0 && <div className="file-list text-xs mt-2">{files.map(f => <div key={f.name}>{f.name} ({(f.size/1e6).toFixed(1)} МБ)</div>)}</div>}
    </div>
  )
}
