generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  fullName    String
  position    String?
  institution String?
  role        String         @default("user")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ownedProjects Project[]     @relation("OwnerProjects")
  projectAccess ProjectAccess[]
  files         File[]
}

model Project {
  id             String         @id @default(uuid())
  name           String
  type           String
  description    String?
  sampleId       String?
  pipelineParams Json?
  computeEnv     Json?
  advanced       Json?
  status         String         @default("active")
  platform       String?        // добавлено из фронтенда
  qcStatus       String?        @default("pending")  // добавлено поле
  experimentDate DateTime?      // добавлено из фронтенда
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ownerId        String
  owner          User           @relation("OwnerProjects", fields: [ownerId], references: [id])
  files          File[]
  sharedAccess   ProjectAccess[]
}

model File {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  stage       String   // например "fastq_r1", "bam", "vcf"
  fileName    String
  fileSize    BigInt?  // размер в байтах
  s3Key       String   // путь в MinIO/S3
  s3Bucket    String
  mimeType    String?
  md5Hash     String?
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime @default(now())
}

model ProjectAccess {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  permission String   @default("read")
  status     String   @default("pending") // pending, accepted, rejected
  invitedBy  String   // userId пригласившего
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, userId])
}